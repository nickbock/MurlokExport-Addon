<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\..\..\..\..\..\WoW\Data\Interface\AddOns\Blizzard_SharedXML\UI.xsd">
	<Script file="ConsumablesList.lua"/>

	<Frame name="ConsumablesListHeaderTemplate" virtual="true">
		<Size y="30"/>
		<Layers>
			<Layer level="OVERLAY">
				<FontString parentKey="Text" inherits="GameFontNormalLarge" justifyH="LEFT">
					<Anchors>
						<Anchor point="BOTTOMLEFT" x="8" y="4"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
	</Frame>

	<Button name="ConsumablesListRowTemplate" mixin="ConsumablesListRowMixin" virtual="true">
		<Size y="26"/>
		<Layers>
			<Layer level="ARTWORK">
				<Texture parentKey="Icon">
					<Size x="22" y="22"/>
					<Anchors>
						<Anchor point="LEFT" x="8"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="OVERLAY">
				<FontString parentKey="Count" inherits="NumberFontNormalSmall" justifyH="RIGHT" hidden="true">
					<Anchors>
						<Anchor point="BOTTOMRIGHT" relativeKey="$parent.Icon" relativePoint="BOTTOMRIGHT" x="2" y="-1"/>
					</Anchors>
				</FontString>
				<FontString parentKey="Slot" inherits="GameFontDisableSmall" justifyH="RIGHT">
					<Anchors>
						<Anchor point="RIGHT" x="-8"/>
					</Anchors>
				</FontString>
				<FontString parentKey="Name" inherits="GameFontHighlight" justifyH="LEFT" wordwrap="false">
					<Anchors>
						<Anchor point="LEFT" relativeKey="$parent.Icon" relativePoint="RIGHT" x="8"/>
						<Anchor point="RIGHT" relativeKey="$parent.Slot" relativePoint="LEFT" x="-8"/>
					</Anchors>
				</FontString>
				<FontString parentKey="Note" inherits="GameFontDisableSmall" justifyH="LEFT" wordwrap="false" hidden="true">
					<Anchors>
						<Anchor point="TOPLEFT" relativeKey="$parent.Name" relativePoint="BOTTOMLEFT" x="0" y="-3"/>
						<Anchor point="RIGHT" x="-8"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<HighlightTexture file="Interface\QuestFrame\UI-QuestTitleHighlight" alphaMode="ADD"/>
		<Scripts>
			<OnEnter method="OnEnter"/>
			<OnLeave method="OnLeave"/>
			<OnClick method="OnClick"/>
		</Scripts>
	</Button>

	<Button name="ConsumablesListNoteRowTemplate" inherits="ConsumablesListRowTemplate" virtual="true">
		<Size y="38"/>
	</Button>

	<Frame name="ConsumablesListFrameTemplate" virtual="true" mixin="ConsumablesListFrameMixin">
		<Layers>
			<Layer level="OVERLAY">
				<FontString parentKey="Updated" inherits="GameFontDisableSmall" justifyH="CENTER">
					<Anchors>
						<Anchor point="BOTTOMLEFT" x="10" y="8"/>
						<Anchor point="BOTTOMRIGHT" x="-10" y="8"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<Frame parentKey="ScrollBox" inherits="WowScrollBoxList">
				<Anchors>
					<Anchor point="TOPLEFT"/>
					<Anchor point="BOTTOMRIGHT" x="-20" y="24"/>
				</Anchors>
			</Frame>
			<EventFrame parentKey="ScrollBar" inherits="MinimalScrollBar">
				<Anchors>
					<Anchor point="TOPLEFT" relativeKey="$parent.ScrollBox" relativePoint="TOPRIGHT" x="6" y="-4"/>
					<Anchor point="BOTTOMLEFT" relativeKey="$parent.ScrollBox" relativePoint="BOTTOMRIGHT" x="6" y="4"/>
				</Anchors>
			</EventFrame>
		</Frames>
		<Scripts>
			<OnLoad method="OnLoad"/>
		</Scripts>
	</Frame>
</Ui>
